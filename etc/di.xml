<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="MageStack\Agent\Api\OllamaConfigurationInterface" type="MageStack\Agent\Model\Service\OllamaConfigurationProvider"/>
    <preference for="MageStack\Agent\Api\OllamaConfigInterface" type="MageStack\Agent\Model\Service\OllamaConfig"/>

    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="magestack_agent_run" xsi:type="object">MageStack\Agent\Console\Command\RunCommand</item>
                <item name="magestack_agent_ask" xsi:type="object">MageStack\Agent\Console\Command\AskCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- Structured logging to var/log/mage-agent.log, separate from system.log/exception.log -->
    <virtualType name="MageStack\Agent\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/mage-agent.log</argument>
        </arguments>
    </virtualType>

    <virtualType name="MageStack\Agent\Logger\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">mageAgent</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">MageStack\Agent\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="MageStack\Agent\Console\Command\AskCommand">
        <arguments>
            <argument name="askService" xsi:type="object">MageStack\Agent\Model\Service\AskService</argument>
        </arguments>
    </type>

    <type name="MageStack\Agent\Model\Service\AskService">
        <arguments>
            <argument name="logger" xsi:type="object">MageStack\Agent\Logger\Logger</argument>
        </arguments>
    </type>

    <type name="MageStack\Agent\Model\Service\AgentSessionService">
        <arguments>
            <argument name="logger" xsi:type="object">MageStack\Agent\Logger\Logger</argument>
        </arguments>
    </type>

</config>
